{
  "name": "atc-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/write-build-info.mjs",
    "import:cifp": "node scripts/import-faa-cifp.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "verify:dist": "node scripts/verify-build.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x"
  }
}
